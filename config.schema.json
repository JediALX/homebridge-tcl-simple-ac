{
  "pluginAlias": "TclSimpleAC",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Exposes TCL Home split air conditioners (e.g. BreezeIN 2.0) as single Apple-like HeaterCooler accessories. Sign in with the same credentials you use in the TCL Home app — your region is discovered automatically from your account, exactly like the app does.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "TCL Simple AC"
      },
      "username": {
        "title": "TCL Home email",
        "type": "string",
        "required": true,
        "format": "email"
      },
      "password": {
        "title": "TCL Home password",
        "type": "string",
        "required": true,
        "x-schema-form": { "type": "password" }
      },
      "pollInterval": {
        "title": "Poll interval (seconds)",
        "type": "integer",
        "default": 15,
        "minimum": 5,
        "maximum": 300,
        "description": "How often to read the AC state from the TCL cloud."
      },
      "enableDehumidifier": {
        "title": "Expose Dry mode as a separate Dehumidifier accessory",
        "type": "boolean",
        "default": false,
        "description": "Adds a second tile per AC controlling the unit's Dry mode. The humidity reading shown by the Home app is a fixed 50% — TCL split ACs have no humidity sensor."
      },
      "devices": {
        "title": "Device allowlist (optional)",
        "type": "array",
        "items": { "title": "Device ID", "type": "string" },
        "description": "Leave empty to expose every split AC on the account. Add TCL device IDs to expose only specific units (IDs are printed in the Homebridge log at startup)."
      },
      "minTemp": {
        "title": "Minimum target temperature (°C)",
        "type": "integer",
        "default": 16
      },
      "maxTemp": {
        "title": "Maximum target temperature (°C)",
        "type": "integer",
        "default": 31
      },
      "loginUrl": {
        "title": "Login URL override",
        "type": "string",
        "placeholder": "https://pa.account.tcl.com/account/login?clientId=54148614"
      },
      "cloudUrlsEndpoint": {
        "title": "Cloud URL discovery endpoint override",
        "type": "string",
        "placeholder": "https://prod-center.aws.tcljd.com/v3/global/cloud_url_get"
      },
      "appId": {
        "title": "App ID override",
        "type": "string",
        "placeholder": "wx6e1af3fa84fbe523"
      },
      "iotEndpoint": {
        "title": "AWS IoT endpoint override",
        "type": "string",
        "description": "Normally auto-discovered. Only set if shadow reads fail."
      },
      "compensation": {
        "title": "External sensor compensation",
        "type": "object",
        "properties": {
          "enabled": {
            "title": "Regulate on a room sensor from the Home app",
            "type": "boolean",
            "default": false,
            "description": "Sends the AC a corrected target so the room, as measured by a Home app sensor, reaches your target. Adds a 'Sensor poll' switch and needs a Home automation: see the README."
          },
          "token": {
            "title": "Token",
            "type": "string",
            "minLength": 16,
            "description": "Shared secret your shortcut sends in the x-token header. At least 16 characters."
          },
          "rooms": {
            "title": "Rooms",
            "type": "array",
            "description": "One entry per AC to compensate. Device IDs are printed in the log at startup.",
            "items": {
              "type": "object",
              "properties": {
                "deviceId": {
                  "title": "TCL device ID",
                  "type": "string"
                },
                "roomKey": {
                  "title": "Room key used in the shortcut",
                  "type": "string",
                  "placeholder": "living"
                }
              }
            }
          },
          "port": {
            "title": "Receiver port",
            "type": "integer",
            "default": 18581,
            "minimum": 1024,
            "maximum": 65535
          },
          "bindHost": {
            "title": "Listen address",
            "type": "string",
            "placeholder": "all interfaces",
            "description": "Optional. The LAN IP of the Homebridge host, to listen on that interface only."
          },
          "sensorPollIntervalSeconds": {
            "title": "Sensor poll interval (seconds)",
            "type": "integer",
            "default": 180,
            "minimum": 60,
            "maximum": 3600
          },
          "staleAfterSeconds": {
            "title": "Ignore readings older than (seconds)",
            "type": "integer",
            "default": 600,
            "minimum": 120,
            "maximum": 7200
          },
          "maxOffset": {
            "title": "Largest correction (°C)",
            "type": "number",
            "default": 5,
            "minimum": 0.5,
            "maximum": 10
          },
          "smoothingMinutes": {
            "title": "Smoothing (minutes)",
            "type": "number",
            "default": 10,
            "minimum": 0,
            "maximum": 120
          },
          "minChangeIntervalSeconds": {
            "title": "Minimum time between automatic writes (seconds)",
            "type": "integer",
            "default": 180,
            "minimum": 60,
            "maximum": 3600
          }
        }
      }
    }
  },
  "layout": [
    "username",
    "password",
    "pollInterval",
    {
      "type": "fieldset",
      "title": "External sensor compensation (optional)",
      "expandable": true,
      "items": [
        "compensation.enabled",
        {
          "key": "compensation.token",
          "condition": {
            "functionBody": "return model.compensation && model.compensation.enabled === true;"
          }
        },
        {
          "key": "compensation.rooms",
          "type": "array",
          "condition": {
            "functionBody": "return model.compensation && model.compensation.enabled === true;"
          },
          "items": [
            "compensation.rooms[].deviceId",
            "compensation.rooms[].roomKey"
          ]
        },
        {
          "type": "fieldset",
          "title": "Receiver and tuning",
          "expandable": true,
          "condition": {
            "functionBody": "return model.compensation && model.compensation.enabled === true;"
          },
          "items": [
            "compensation.port",
            "compensation.bindHost",
            "compensation.sensorPollIntervalSeconds",
            "compensation.staleAfterSeconds",
            "compensation.maxOffset",
            "compensation.smoothingMinutes",
            "compensation.minChangeIntervalSeconds"
          ]
        }
      ]
    },
    "enableDehumidifier",
    {
      "type": "fieldset",
      "title": "Devices",
      "expandable": true,
      "items": ["devices", "minTemp", "maxTemp"]
    },
    {
      "type": "fieldset",
      "title": "Advanced (region/endpoint overrides)",
      "expandable": true,
      "items": ["loginUrl", "cloudUrlsEndpoint", "appId", "iotEndpoint"]
    }
  ]
}
